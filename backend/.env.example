# Configuración de base de datos
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_base_datos
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-segura

# Configuración JWT (RFC 7519, RFC 8725)
JWT_SECRET=cambia-esto-por-un-valor-seguro-generado-con-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Cifrado en reposo AES-256-GCM con anillo de llaves (FIPS 197, NIST SP 800-38D, NIST SP 800-57 Part 1)
ENC_KEYS=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA,v2:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
ENC_KEY_CURRENT=v2
