# copiar a .env y completar. no subir .env a git.

DATABASE_URL= # postgresql local (usuario:password@host:puerto/basedatos)
JWT_SECRET= # secreto para firmar tokens jwt (generado con secrets.token_hex(32))
JWT_ALGORITHM= # algoritmo de firma del jwt
JWT_EXPIRE_MINUTES= # minutos de vida del token
ENCRYPTION_KEY= # llave fernet para aes-256 (generado con Fernet.generate_key())