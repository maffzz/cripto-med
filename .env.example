# Configuración de base de datos
POSTGRES_DB=criptomed
POSTGRES_USER=criptomed
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-segura
APP_DB_USER=app_user
APP_DB_PASSWORD=cambia-esto
# DATABASE_URL usa POSTGRES_USER (rol dueño) por simplicidad
# APP_DB_USER y APP_DB_PASSWORD se usan para crear el rol de aplicación en Docker init
DATABASE_URL=postgresql://criptomed:cambia-esto-por-una-contraseña-segura@db:5432/criptomed
OWNER_DATABASE_URL=postgresql://criptomed:cambia-esto-por-una-contraseña-segura@db:5432/criptomed

# Configuración JWT
JWT_SECRET=cambia-esto-por-un-valor-seguro-generado-con-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Configuración de encriptación (Fernet AES-256)
ENCRYPTION_KEY=cambia-esto-por-una-llave-fernet-generada-con-Fernet-generate-key
ENC_KEYS=3
ENC_KEY_CURRENT=cambia-esto-llave-actual

# Configuración de aplicación
ALLOWED_ORIGINS=https://localhost:8443
ENV=development
BACKUP_PASSPHRASE=cambia-esto-passphrase-backup

# Credenciales de demo (para seed_db)
DEMO_PASSWORD_ADMIN=cambia-esto
DEMO_PASSWORD_DOCTOR=cambia-esto
DEMO_PASSWORD_ADMINISTRATIVO=cambia-esto
DEMO_PASSWORD_AUDITOR=cambia-esto
DEMO_PASSWORD_PACIENTE=cambia-esto
